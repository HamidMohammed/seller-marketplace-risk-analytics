GO


/* =========================================================
   RECOMMENDED SENTIMENT LOGIC
   =========================================================

1-2  -> Negative
3    -> Neutral
4-5  -> Positive

========================================================= */


/* =========================================================
   RECOMMENDED ETL DERIVATIONS
   =========================================================

negative_review_flag =
    CASE
        WHEN review_score <= 2 THEN 1
        ELSE 0
    END

neutral_review_flag =
    CASE
        WHEN review_score = 3 THEN 1
        ELSE 0
    END

positive_review_flag =
    CASE
        WHEN review_score >= 4 THEN 1
        ELSE 0
    END

review_text_exists_flag =
    CASE
        WHEN review_message IS NOT NULL
             AND LTRIM(RTRIM(review_message)) <> ''
        THEN 1
        ELSE 0
    END

review_response_days =
    DATEDIFF(
        DAY,
        review_creation_timestamp,
        review_answer_timestamp
    )

========================================================= */


/* =========================================================
   IMPORTANT MODELING RULE
   =========================================================

Recommended seller attribution strategy:

Use only single-seller delivered orders
for reliable seller-review attribution.

Recommended filter:

seller_count = 1

This avoids:
- ambiguous seller responsibility
- mixed review attribution
- unreliable seller satisfaction KPIs

========================================================= */