/* =========================================================
   FACT TABLE: fct_seller_acquisition
   SQL Server Compatible DDL
   Grain:
   ONE ROW = ONE SELLER ACQUISITION EVENT
   ========================================================= */

CREATE TABLE fct_seller_acquisition (

    /* =====================================================
       SURROGATE PRIMARY KEY
       ===================================================== */

    seller_acquisition_fact_sk BIGINT IDENTITY(1,1) PRIMARY KEY,


    /* =====================================================
       BUSINESS IDENTIFIERS
       ===================================================== */

    mql_id VARCHAR(50) NOT NULL,

    seller_id VARCHAR(50) NULL,


    /* =====================================================
       FOREIGN KEYS
       ===================================================== */

    seller_sk_fk BIGINT NULL,

    first_contact_date_sk INT NOT NULL,

    lead_qualification_date_sk INT NULL,

    conversion_date_sk INT NULL,


    /* =====================================================
       ACQUISITION ATTRIBUTES
       ===================================================== */

    acquisition_channel VARCHAR(100) NULL,

    lead_type VARCHAR(100) NULL,

    lead_behavior_profile VARCHAR(100) NULL,

    business_segment VARCHAR(100) NULL,

    declared_monthly_revenue DECIMAL(14,2) NULL,

    expected_sales_volume VARCHAR(50) NULL,

    lead_conversion_status VARCHAR(30) NOT NULL,


    /* =====================================================
       DERIVED METRICS
       ===================================================== */

    days_to_convert INT NULL,

    converted_flag BIT NOT NULL DEFAULT 0,

    high_value_seller_flag BIT NOT NULL DEFAULT 0,

    acquisition_risk_category VARCHAR(30) NULL,


    /* =====================================================
       AUDIT COLUMN
       ===================================================== */

    load_timestamp DATETIME2 DEFAULT GETDATE(),


    /* =====================================================
       FOREIGN KEY CONSTRAINTS
       ===================================================== */

    CONSTRAINT fk_acquisition_seller
        FOREIGN KEY (seller_sk_fk)
        REFERENCES dim_seller(seller_sk),

    CONSTRAINT fk_acquisition_first_contact_date
        FOREIGN KEY (first_contact_date_sk)
        REFERENCES dim_date(date_sk),

    CONSTRAINT fk_acquisition_qualification_date
        FOREIGN KEY (lead_qualification_date_sk)
        REFERENCES dim_date(date_sk),

    CONSTRAINT fk_acquisition_conversion_date
        FOREIGN KEY (conversion_date_sk)
        REFERENCES dim_date(date_sk),


    /* =====================================================
       UNIQUENESS CONSTRAINT
       ===================================================== */

    CONSTRAINT uq_mql_id
        UNIQUE (mql_id),


    /* =====================================================
       DATA QUALITY CONSTRAINTS
       ===================================================== */

    CONSTRAINT chk_days_to_convert
        CHECK (
            days_to_convert IS NULL
            OR days_to_convert >= 0
        ),

    CONSTRAINT chk_declared_revenue
        CHECK (
            declared_monthly_revenue IS NULL
            OR declared_monthly_revenue >= 0
        ),

    CONSTRAINT chk_conversion_status
        CHECK (
            lead_conversion_status IN (
                'Converted',
                'Not Converted',
                'Pending'
            )
        ),

    CONSTRAINT chk_risk_category
        CHECK (
            acquisition_risk_category IS NULL
            OR acquisition_risk_category IN (
                'Low Risk',
                'Medium Risk',
                'High Risk',
                'Critical Risk'
            )
        )

);

GO


