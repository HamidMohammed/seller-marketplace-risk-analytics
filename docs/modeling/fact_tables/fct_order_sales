GO

CREATE INDEX idx_sales_order_status
ON fct_order_sales(order_status);

GO

CREATE INDEX idx_sales_payment_type
ON fct_order_sales(payment_type);

GO

CREATE INDEX idx_sales_high_value
ON fct_order_sales(high_value_order_flag);

GO

