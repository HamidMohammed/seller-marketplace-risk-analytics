/* =========================================================
   FACT TABLE: fct_order_sales
   SQL Server Compatible DDL
   Grain:
   ONE ROW = ONE SOLD ORDER ITEM
   ========================================================= */

CREATE TABLE fct_order_sales (

    /* =====================================================
       SURROGATE PRIMARY KEY
       ===================================================== */

    sales_fact_sk BIGINT IDENTITY(1,1) PRIMARY KEY,


    /* =====================================================
       BUSINESS IDENTIFIERS
       ===================================================== */

    order_id VARCHAR(50) NOT NULL,

    order_item_id INT NOT NULL,


    /* =====================================================
       FOREIGN KEYS
       ===================================================== */

    customer_sk_fk BIGINT NOT NULL,

    seller_sk_fk BIGINT NOT NULL,

    product_sk_fk BIGINT NOT NULL,

    purchase_date_sk INT NOT NULL,

    approval_date_sk INT NULL,

    delivered_date_sk INT NULL,


    /* =====================================================
       ORDER ATTRIBUTES
       ===================================================== */

    order_status VARCHAR(30) NOT NULL,


    /* =====================================================
       SALES METRICS
       ===================================================== */

    item_price DECIMAL(12,2) NOT NULL,

    freight_value DECIMAL(12,2) NOT NULL,

    total_sales_value DECIMAL(12,2) NOT NULL,

    gross_merchandise_value DECIMAL(12,2) NOT NULL,

    payment_value_allocated DECIMAL(12,2) NULL,

    installment_count INT NULL,

    payment_type VARCHAR(30) NULL,

    product_quantity INT NOT NULL DEFAULT 1,


    /* =====================================================
       COMMERCIAL ANALYTICS
       ===================================================== */

    freight_ratio DECIMAL(10,4) NULL,

    high_value_order_flag BIT NOT NULL DEFAULT 0,


    /* =====================================================
       AUDIT COLUMN
       ===================================================== */

    load_timestamp DATETIME2 DEFAULT GETDATE(),


    /* =====================================================
       FOREIGN KEY CONSTRAINTS
       ===================================================== */

    CONSTRAINT fk_sales_customer
        FOREIGN KEY (customer_sk_fk)
        REFERENCES dim_customer(customer_sk),

    CONSTRAINT fk_sales_seller
        FOREIGN KEY (seller_sk_fk)
        REFERENCES dim_seller(seller_sk),

    CONSTRAINT fk_sales_product
        FOREIGN KEY (product_sk_fk)
        REFERENCES dim_product(product_sk),

    CONSTRAINT fk_sales_purchase_date
        FOREIGN KEY (purchase_date_sk)
        REFERENCES dim_date(date_sk),

    CONSTRAINT fk_sales_approval_date
        FOREIGN KEY (approval_date_sk)
        REFERENCES dim_date(date_sk),

    CONSTRAINT fk_sales_delivered_date
        FOREIGN KEY (delivered_date_sk)
        REFERENCES dim_date(date_sk),


    /* =====================================================
       BUSINESS GRAIN ENFORCEMENT
       ===================================================== */

    CONSTRAINT uq_sales_order_item
        UNIQUE (order_id, order_item_id),


    /* =====================================================
       DATA QUALITY CONSTRAINTS
       ===================================================== */

    CONSTRAINT chk_item_price
        CHECK (item_price >= 0),

    CONSTRAINT chk_freight_value
        CHECK (freight_value >= 0),

    CONSTRAINT chk_total_sales_value
        CHECK (total_sales_value >= 0),

    CONSTRAINT chk_gmv
        CHECK (gross_merchandise_value >= 0),

    CONSTRAINT chk_payment_allocated
        CHECK (
            payment_value_allocated IS NULL
            OR payment_value_allocated >= 0
        ),

    CONSTRAINT chk_product_quantity
        CHECK (product_quantity > 0),

    CONSTRAINT chk_installments
        CHECK (
            installment_count IS NULL
            OR installment_count > 0
        ),

    CONSTRAINT chk_freight_ratio
        CHECK (
            freight_ratio IS NULL
            OR freight_ratio >= 0
        ),

    CONSTRAINT chk_order_status
        CHECK (
            order_status IN (
                'created',
                'approved',
                'invoiced',
                'processing',
                'shipped',
                'delivered',
                'canceled',
                'unavailable'
            )
        )

);

GO


