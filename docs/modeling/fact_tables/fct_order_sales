ON fct_order_sales(total_sales_value);

GO


/* =========================================================
   RECOMMENDED ETL DERIVATIONS
   =========================================================

total_sales_value =
    item_price + freight_value

gross_merchandise_value =
    item_price

freight_ratio =
    freight_value / NULLIF(item_price, 0)

high_value_order_flag =
    CASE
        WHEN total_sales_value >= 1000
        THEN 1
        ELSE 0
    END

========================================================= */


/* =========================================================
   PAYMENT ALLOCATION STRATEGY
   =========================================================

The Olist payment dataset is order-level,
while this fact is item-level.

Recommended proportional allocation:

payment_value_allocated =
(
    item_price
    / total_order_item_price
)
* payment_value

This preserves:
- seller revenue attribution
- item-level profitability analysis
- commercial consistency

========================================================= */


